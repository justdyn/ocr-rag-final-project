{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./app/assets/tailwind.css -o ./public/tailwind.css",
    "dev:css": "tailwindcss -i ./app/assets/tailwind.css -o ./public/tailwind.css --watch",
    "dev:server": "node --watch --import remix/node-tsx server.ts",
    "dev": "npm run build:css && concurrently -k \"npm run dev:css\" \"npm run dev:server\"",
    "start": "npm run build:css && node --import remix/node-tsx server.ts",
    "test": "node --import remix/node-tsx --test \"**/*.test.ts\" \"**/*.test.tsx\"",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "framer-motion": "^13.1.1",
    "lenis": "^1.3.23",
    "lucide": "^1.17.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "remix": "^3.0.0-beta.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.3.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "latest",
    "@types/unist": "^3.0.3",
    "concurrently": "^9.2.0",
    "linkedom": "^0.18.14",
    "tailwindcss": "^4.3.0",
    "typescript": "latest"
  }
}
