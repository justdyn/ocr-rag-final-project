# Product
APP_NAME=tensho

# Database (async SQLite default; swap to Postgres-compatible URL for later)
# Example Postgres: postgresql+asyncpg://user:pass@localhost:5432/tensho
DATABASE_URL=sqlite+aiosqlite:///./data/tensho.db
# WAL is on by default (needed for concurrent multi-file upload). Set 0 to keep DELETE journal.
DATABASE_ENABLE_SQLITE_WAL=1
# Per-connection lock wait in milliseconds (SQLite default is 0 = fail immediately).
SQLITE_BUSY_TIMEOUT_MS=8000

# Paths (relative to backend/ unless absolute)
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
CHROMA_PERSIST_DIR=./data/chroma

# Auth (issued by FastAPI; Remix BFF stores JWT in httpOnly cookie)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# OCR provider: tesseract | cloud
OCR_ENGINE=tesseract

# Upload size limit (bytes). Default 25 MiB.
MAX_UPLOAD_BYTES=26214400

# Embeddings / chunking defaults (used by later steps)
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=100

# Hybrid retrieval (weighted RRF; always-on for /api/query mode=hybrid)
RRF_CONSTANT=60
BM25_WEIGHT=0.5
VECTOR_WEIGHT=0.5

# LLM — OpenAI-compatible cloud API (required for /api/chat/completions)
# Leave LLM_API_KEY unset to fail fast with a clear 503 (no silent fallback).
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=120
CHAT_RETRIEVAL_K=5
